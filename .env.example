SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_... hoặc service_role): CHỈ để ở server, không đưa lên frontend/git
SUPABASE_SERVICE_ROLE_KEY=
# Mật khẩu đăng nhập app
APP_PASSWORD=
# Chuỗi ngẫu nhiên dài (>= 32 ký tự) để ký token
TOKEN_SECRET=
PORT=3000
# (Tuỳ chọn) Khoá Google Maps Platform, chỉ để ở server: bật Geocoding API và Routes API.
# Không có khoá vẫn dán được link Google Maps / toạ độ và tính khoảng cách đường chim bay.
GOOGLE_MAPS_API_KEY=
# (Tuỳ chọn) Khoá riêng cho trình duyệt để hiện bản đồ Google trong app: bật Maps JavaScript API,
# giới hạn theo tên miền web (HTTP referrer). Không có thì app hiện bản đồ OpenStreetMap.
GOOGLE_MAPS_BROWSER_KEY=
